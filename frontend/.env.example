VITE_API_URL=http://localhost:8080

# Eigene Basis-Domain(s) der Anwendung, komma-getrennt. Hosts, die
# NICHT auf eine dieser Domains enden, werden als mögliche Custom Domain per
# Backend-Lookup aufgelöst statt per Subdomain-Namenskonvention geraten.
# Leer lassen = keine Subdomain-Konvention: Statusseiten sind unter /status/<slug>
# oder über eine eigene Domain erreichbar.
VITE_APP_BASE_DOMAINS=example.com
