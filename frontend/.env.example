VITE_API_URL=http://localhost:8080

# The application's own base domain(s), comma-separated. Hosts that do NOT end in one of these
# domains are resolved as a possible custom domain via a backend lookup instead of being guessed
# from the subdomain naming convention.
# Leave empty = no subdomain convention: status pages are reachable under /status/<slug> or via a
# custom domain.
VITE_APP_BASE_DOMAINS=example.com
