DB_DSN="host=localhost user=postgres password=localpassword dbname=statushafen port=5432 sslmode=disable TimeZone=UTC"
# Pflicht, mindestens 32 Zeichen, zufällig. Der Start bricht bei leerem, zu kurzem oder bekanntem
# Platzhalterwert ab. Erzeugen mit: openssl rand -base64 48
# (./start.sh erzeugt für die lokale Entwicklung selbst eines in backend/.jwt-secret.local.)
JWT_SECRET=
PORT="8080"
# Reverse-Proxys, deren X-Forwarded-For/-Proto vertraut wird (kommagetrennte IPs/CIDRs); leer = keine.
# Nur den eigenen Proxy eintragen. Netze weiter als /8 (IPv4) bzw. /16 (IPv6), z. B. 0.0.0.0/0 oder ::/0,
# lassen jeden Client seine Adresse fälschen (IP-Limits wirkungslos): Der Start bricht damit ab,
# außer APP_ENV ist development, dev, test oder local (dann nur Warnung).
# TRUSTED_PROXIES="10.0.0.5"
CORS_ORIGINS="http://localhost:5173,https://yourdomain.com"
# Seed/Reset nur lokal: SEED_DB="true" wirkt ausschließlich mit APP_ENV=development, dev, test oder
# local (jeder andere oder leere Wert sperrt, auch "production"). Dabei werden Tabellen GELÖSCHT.
APP_ENV="development"
SEED_DB="false"
# Logging: LOG_FORMAT=json|text (Default: json bei APP_ENV=production, sonst text),
# LOG_LEVEL=debug|info|warn|error (Default info)
LOG_FORMAT=""
LOG_LEVEL=""
# Betreiber-Webhook für die ganze Instanz: erhält nur Vorfälle öffentlicher Seiten, nie die privater Seiten
GOOGLE_CHAT_WEBHOOK_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Kommagetrennte Liste erlaubter E-Mail-Domains fürs SSO-Auto-Provisioning; leer = kein Filter
SSO_ALLOWED_DOMAINS=""
# Kommagetrennte Liste von E-Mails, die bei jedem SSO-Login automatisch Global Admin werden
# (Bootstrap für den allerersten Admin, wenn SEED_DB in Produktion deaktiviert ist)
SSO_BOOTSTRAP_ADMIN_EMAILS=""

# SMTP-Konfiguration für Incident-/Subscriber-Benachrichtigungen (DispatchNotifications).
# Anbieter-unabhängig (z.B. SendGrid, Postmark, eigener Server) via net/smtp PlainAuth.
# Bleiben diese Vars leer, fällt der Code auf den lokalen Mailpit-Server aus
# docker-compose.yml zurück (localhost:1025, ohne Auth) - lokale Entwicklung ist
# also unverändert.
SMTP_HOST=""
SMTP_PORT=""
# Optional: nur setzen, wenn der SMTP-Server Auth verlangt (PlainAuth). Bleiben
# SMTP_USER/SMTP_PASSWORD leer, wird unauthentifiziert verbunden (wie Mailpit).
SMTP_USER=""
SMTP_PASSWORD=""
# Absenderadresse; leer = Default "alerts@statushafen.local"
SMTP_FROM=""

# Basic-Auth-Zugangsdaten für den Prometheus-/metrics-Endpunkt.
# Wenn eine der beiden Variablen leer/ungesetzt ist, wird /metrics gar nicht
# erst gemountet (fail-closed), statt unauthentifiziert erreichbar zu sein.
METRICS_BASIC_AUTH_USER=""
METRICS_BASIC_AUTH_PASSWORD=""

# Optional: Link auf das Grafana-Dashboard der jeweiligen Umgebung.
# Erscheint als "Grafana-Dashboard öffnen" im Admin-Bereich unter Monitoring
# (nur Global Admins). Nur http(s)-URLs; leer = Link wird nicht angezeigt.
# Dashboard-Variable var-env passend zur Umgebung setzen, z.B. production:
# GRAFANA_DASHBOARD_URL="https://<stack>.grafana.net/d/<uid>/<slug>?orgId=1&var-env=production"
GRAFANA_DASHBOARD_URL=""

# Nur lokale Entwicklung: Kommagetrennte Liste von OIDC-Issuern,
# die ohne TLS und auf internen Adressen (localhost) laufen dürfen, z.B. der
# Mock-OIDC-Dienst aus docker-compose.yml (Profil "sso"). Exakter Vergleich,
# nur mit APP_ENV=development, dev, test oder local wirksam (sonst wirkungslos). Leer = https-Pflicht und SSRF-Schutz
# gelten für jeden Issuer.
OIDC_DEV_INSECURE_ISSUERS=""

# Eigene Domains (On-Demand-TLS): gemeinsames Secret für
# /api/internal/custom-domain-check (Header X-Internal-Token). Pflicht, sobald
# APP_ENV nicht development/test/local ist; ohne Wert antwortet der Endpunkt mit 503.
CADDY_INTERNAL_TOKEN=""

# Hintergrund-Abruf externer Statusseiten (z. B. GitHub) im
# Takt der jeweiligen Quelle. Default an; "false"/"0"/"no"/"off" schaltet ihn
# ab ("Jetzt abrufen" im Admin funktioniert dann weiterhin).
EXTERNAL_STATUS_POLLING_ENABLED="true"

# Automatische Übersetzung: LibreTranslate des Betreibers. Die Adresse gilt als
# vertrauenswürdig und darf intern sein (z. B. Docker-Dienst). Leer = kein Standarddienst;
# Admins können unter Systemeinstellungen einen eigenen Zugang (LibreTranslate/DeepL) eintragen.
# LIBRETRANSLATE_URL=http://libretranslate:5000
# LIBRETRANSLATE_API_KEY=
